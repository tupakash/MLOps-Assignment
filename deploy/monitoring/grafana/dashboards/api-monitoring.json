                },
                "1": {
                  "color": "green",
                  "text": "Up"
                }
              },
              "type": "value"
            }
          ],
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "up{job=\"heart-disease-api\"}",
          "legendFormat": "API",
          "refId": "A"
        }
      ],
      "title": "API availability",
      "type": "stat"
    }
  ],
